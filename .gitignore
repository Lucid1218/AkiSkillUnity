# Publish only the MochiFitter tool package from this Unity workspace.
# The rest of the project contains local avatars, outfits, Unity state, and
# one-off Blender/profile-generation artifacts.
/*
!/.gitignore
!/.gitattributes
!/Assets/
!/Examples/

/Assets/*
!/Assets/OutfitRetargetingSystem/
!/Assets/OutfitRetargetingSystem.meta
!/Assets/Neolithe Blender DevKit 1.0.0_raw_userTpose3.fbx
!/Assets/Neolithe Blender DevKit 1.0.0_raw_userTpose3.fbx.meta
!/Assets/Neolithe Blender DevKit 1.0.0_raw_userTpose3_baked.fbx
!/Assets/Neolithe Blender DevKit 1.0.0_raw_userTpose3_baked.fbx.meta
!/Assets/Neolithe Blender DevKit 1.0.0_raw_userTpose3_baked.omochi
!/Assets/Neolithe Blender DevKit 1.0.0_raw_userTpose3_baked.omochi.meta

/Examples/*
!/Examples/NeolitheTpose3/

# Local results and generated avatar-specific data are not part of the tool.
/Assets/OutfitRetargetingSystem/Outputs/
/Assets/OutfitRetargetingSystem/Outputs.meta
/Assets/OutfitRetargetingSystem/Editor/GeneratedProfiles/*
!/Assets/OutfitRetargetingSystem/Editor/GeneratedProfiles/neolithe_blender_devkit_1_0_0_raw_usertpose3_baked/
!/Assets/OutfitRetargetingSystem/Editor/GeneratedProfiles/neolithe_blender_devkit_1_0_0_raw_usertpose3_baked.meta
!/Assets/OutfitRetargetingSystem/Editor/GeneratedProfiles.meta
/Assets/OutfitRetargetingSystem/Editor/TestingDatasets/
/Assets/OutfitRetargetingSystem/Editor/TestingDatasets.meta

# Editor and Blender caches/backups within the package.
**/__pycache__/
**/__pycache__.meta
*.pyc
*.pyc.meta
*.blend1
*.blend1.meta
*.log
*.log.meta
*.tmp
*.tmp.meta
